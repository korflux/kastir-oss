{
  "name": "kastir",
  "version": "2.4.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build:public-scripts": "node scripts/build-public-scripts.mjs",
    "dev": "node scripts/build-public-scripts.mjs && next dev",
    "build": "node scripts/build-public-scripts.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:build": "node scripts/validate-build.mjs",
    "test:docker-build": "docker build --progress=plain --tag kastir:phase-40 .",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm lint && pnpm test && pnpm test:build",
    "push": "node scripts/git-push.mjs",
    "prisma": "prisma"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/oauth-provider": "1.7.0-rc.4",
    "@better-auth/prisma-adapter": "1.7.0-rc.4",
