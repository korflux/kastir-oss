# Copy this file to `.env` before `pnpm dev` / `npm run dev`:
#   cp .env.example .env
#
# .env = canonical LOCAL test/dev stack (NOT production / NOT client host).
# Required: Postgres + Redis on loopback. Either:
#   docker compose up -d
# or native Postgres 16 + Redis on ports 5432 / 6379 (same credentials below).
# Local test stack only: Postgres and Redis on loopback. Never point at a client/prod host.
# See AGENTS.md: "Regras invioláveis" item 1 and "Verificação no browser".
#
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_TOKEN=

# PostgreSQL and Redis services
DATABASE_URL=postgresql://kastir:kastir@localhost:5432/kastir
REDIS_URL=redis://:kastir@localhost:6379

# Authentication
# NEXTAUTH_SECRET must be at least 32 characters.
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
# Public origin of this app (cookies, CSRF, redirects). Must match the URL browsers use.
BETTER_AUTH_URL=http://localhost:3000
# Optional MCP resource-server credential override. By default Kastir derives
# and provisions a private introspection client from NEXTAUTH_SECRET on boot.
# MCP_INTROSPECTION_CLIENT_ID=kastir-mcp-resource-server
# MCP_INTROSPECTION_CLIENT_SECRET=replace-with-a-long-random-secret
# Set true only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP.
# Also gates the Split Tests telemetry rate limiter's per-IP key (see
# lib/Modules/SplitTests/telemetryRateLimit.ts) — if false, that limiter's
# budget is shared per-campaign instead of per-visitor. nginx.conf overwrites
# both headers from the direct connection, so set true in Docker behind it.
AUTH_TRUST_PROXY=false

# Master bootstrap
MASTER_EMAIL=admin@example.com
# MASTER_PASSWORD must be at least 8 characters. Local e2e uses `change-me`.
MASTER_PASSWORD=replace-with-a-strong-password
MASTER_FORCE_RESET=false

# Initial panel settings
SITE_TITLE=Kastir
PANEL_LANGUAGE=en
