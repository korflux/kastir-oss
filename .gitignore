desktop.ini
.next/
# Tipos do Next regenerados em `next dev`/`next build`; versionado só gera diff espúrio
next-env.d.ts
.tools/
node_modules/
coverage/
app/generated/prisma/
*.tsbuildinfo
.pnpm-store/
.env
.env.*
!.env.example
# Cliente MCP local do agente (OAuth/metadata da máquina; nunca no repo)
.mcp.json
.mcp-metadata.json
test-results/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel/
out/
build/
.build-public/
# Generated by scripts/bundle-bootstrap.mjs (Dockerfile builder / publish)
scripts/bootstrap-runtime.mjs
# Runtime media volumes (never commit uploads or private staging)
.media-staging/
public/uploads/
# Published page HTML + site artifacts are runtime output (regeneratePublicArtifacts /
# page-rebuild). Never commit local/e2e state into the image seed.
public/*/
!public/admin-brand/
!public/_kastir/
public/robots.txt
public/sitemap.xml
public/llms.txt
public/index.html
# Generated published-site scripts (pnpm build:public-scripts); source is public-scripts/
public/_kastir/*.js
public/_kastir/backups/
!public/_kastir/.gitkeep

# Notas locais de fluxo de trabalho (fases, erros fora do escopo); nunca vão para o repositório público
.vibeflow/
.erros-encontrados/
